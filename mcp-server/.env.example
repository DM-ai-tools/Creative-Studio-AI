# CreativeStudio API base (include /api/v1)
CREATIVESTUDIO_API_URL=http://localhost:8000/api/v1

# Login as a CreativeStudio user (MCP acts on their behalf)
CREATIVESTUDIO_EMAIL=admin@example.com
CREATIVESTUDIO_PASSWORD=change_me_in_production

# Or skip login and pass a JWT directly:
# CREATIVESTUDIO_ACCESS_TOKEN=

# Optional: protect the remote MCP HTTP endpoint (Claude Cowork / custom connector)
# Clients should send: Authorization: Bearer <this value>
MCP_API_KEY=

# Streamable HTTP bind (used when running with --transport http)
MCP_HOST=0.0.0.0
MCP_PORT=8100
